#!/usr/bin/env bash
set -euo pipefail
case "${1:-}" in -h|--help)
  cat <<USAGE
Usage: ccr-doctor [--json]
Diagnose CCR installation, hooks, cmux, git, and runtime state.
--json prints machine-readable diagnostics for scripts and CI.
USAGE
  exit 0
;; esac
exec python3 "$HOME/.local/bin/ccr-hook.py" --command doctor "$@"
