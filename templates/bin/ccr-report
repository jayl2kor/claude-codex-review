#!/usr/bin/env bash
set -euo pipefail
case "${1:-}" in -h|--help)
  cat <<USAGE
Usage: ccr-report [--session ID] [--outcome OUT] [--print]
Generate (or regenerate) a Markdown report for the latest or given session.
USAGE
  exit 0
;; esac
exec python3 "$HOME/.local/bin/ccr-hook.py" --command report "$@"
