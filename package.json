{
  "name": "claude-codex-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Claude-Codex Review (CCR) loop for cmux: a hook-based two-agent review workflow.",
  "bin": {
    "ccr": "bin/ccr"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jayl2kor/claude-codex-review.git"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "scripts",
    "docs",
    "README.md"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "install:ccr": "bun run src/install.ts",
    "test": "bun test",
    "check:sync": "bun run scripts/check-templates-sync.ts",
    "typecheck": "tsc --noEmit",
    "build-check": "bun build src/install.ts --target=bun --outfile=/dev/null",
    "build:cli": "bun run scripts/build-cli.ts",
    "extract:templates": "bun run scripts/extract-templates.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3"
  }
}
